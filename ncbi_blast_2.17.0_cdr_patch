+static const string kArgCDRMode("cdr_mode");
+static const string kArgCDRMaxMismatches("cdr_max_mismatches");
+static const string kArgCDRDist("cdr_dist");
+static const string kArgCDRAnyOrder("cdr_any_order");
+static const string kArgCDROutFmt("cdr_outfmt");
+static const string kArgCDRChainMinIdent("cdr_chain_min_ident");
+
+void
+CCDRSearchArgs::SetArgumentDescriptions(CArgDescriptions& arg_desc)
+{
+    arg_desc.SetCurrentGroup("CDR (Antibody/TCR) Search Options");
+
+    arg_desc.AddFlag(kArgCDRMode,
+                     "Enable CDR (Antibody/TCR) search mode for 3+ CDR queries "
+                     "(CDR1, CDR2, CDR3, plus optional 4th full Chain/V-region query) "
+                     "with framework distance constraints and hierarchical scoring",
+                     true);
+
+    arg_desc.AddOptionalKey(kArgCDRMaxMismatches, "mismatches",
+                            "Maximum allowed mismatches for each CDR query "
+                            "(comma-separated integers, e.g. '1,2,1' or single integer '2' for all CDRs). "
+                            "Default = '2,2,2'",
+                            CArgDescriptions::eString);
+
+    string dflt_dist = m_IsProtein ? "10:25,30:50" : "30:75,90:150";
+    arg_desc.AddOptionalKey(kArgCDRDist, "distances",
+                            "Allowed inter-CDR framework distances in residues/bases "
+                            "(e.g. '10:25,30:50' or '10:50' for both intervals). "
+                            "Default = '" + dflt_dist + "'",
+                            CArgDescriptions::eString);
+
+    arg_desc.AddFlag(kArgCDRAnyOrder,
+                     "Allow CDR1, CDR2, CDR3 to occur in arbitrary order along the subject sequence "
+                     "(default requires sequential order CDR1 -> CDR2 -> CDR3)",
+                     true);
+
+    arg_desc.AddOptionalKey(kArgCDRChainMinIdent, "percent",
+                            "Minimum percent identity (0..100) for optional 4th full Chain / V-Region query "
+                            "(searched in UNION / OR mode alongside CDRs). Default = 70.0",
+                            CArgDescriptions::eDouble);
+
+    arg_desc.AddOptionalKey(kArgCDROutFmt, "format",
+                            "CDR search output format:\n"
+                            "  full       = Detailed Antibody/CDR report with summary table, visual domain map, and alignments (default in -cdr_mode)\n"
+                            "  tsv        = Tab-separated Antibody/CDR summary table (1 row per matched sequence/patent)\n"
+                            "  json       = Structured JSON Antibody/CDR report (queries, parameters, Venn masks, ranked patents/subjects, and alignments)\n"
+                            "  compact    = High-recall ClickHouse-ready flat numeric TSV (Venn bitmasks, coordinates, scores, no ASCII alignments)\n"
+                            "  blast      = Standard BLAST output formatting (respects -outfmt)",
+                            CArgDescriptions::eString);
+
+    arg_desc.SetCurrentGroup("");
+}
+
+void
+CCDRSearchArgs::ExtractAlgorithmOptions(const CArgs& args, CBlastOptions& opts)
+{
+    bool cdr_active = false;
+    if (args.Exist(kArgCDRMode) && args[kArgCDRMode]) {
+        cdr_active = true;
+    }
+    if ((args.Exist(kArgCDRMaxMismatches) && args[kArgCDRMaxMismatches]) ||
+        (args.Exist(kArgCDRDist) && args[kArgCDRDist]) ||
+        (args.Exist(kArgCDRAnyOrder) && args[kArgCDRAnyOrder]) ||
+        (args.Exist(kArgCDRChainMinIdent) && args[kArgCDRChainMinIdent]) ||
+        (args.Exist(kArgCDROutFmt) && args[kArgCDROutFmt])) {
+        cdr_active = true;
+    }
+
+    if (!cdr_active) {
+        return;
+    }
+
+    opts.SetCDRMode(true);
+    opts.SetCDRAnyOrder(args.Exist(kArgCDRAnyOrder) && args[kArgCDRAnyOrder]);
+
+    double chain_min_ident = 70.0;
+    if (args.Exist(kArgCDRChainMinIdent) && args[kArgCDRChainMinIdent]) {
+        chain_min_ident = args[kArgCDRChainMinIdent].AsDouble();
+        if (chain_min_ident <= 0.0 || chain_min_ident > 100.0) {
+            NCBI_THROW(CInputException, eInvalidInput,
+                       "-cdr_chain_min_ident must be in range (0, 100]");
+        }
+    }
+    opts.SetCDRChainMinIdent(chain_min_ident);
+
+    // Default distances based on molecule type
+    int min12 = m_IsProtein ? 10 : 30;
+    int max12 = m_IsProtein ? 25 : 75;
+    int min23 = m_IsProtein ? 30 : 90;
+    int max23 = m_IsProtein ? 50 : 150;
+
+    if (args.Exist(kArgCDRDist) && args[kArgCDRDist]) {
+        string dist_str = NStr::TruncateSpaces(args[kArgCDRDist].AsString());
+        vector<string> parts;
+        NStr::Split(dist_str, ",", parts);
+        auto parse_range = [](const string& s, int& lo, int& hi) {
+            string s1, s2;
+            if (NStr::SplitInTwo(s, ":", s1, s2) || NStr::SplitInTwo(s, "-", s1, s2)) {
+                lo = NStr::StringToInt(NStr::TruncateSpaces(s1));
+                hi = NStr::StringToInt(NStr::TruncateSpaces(s2));
+            } else {
+                NCBI_THROW(CInputException, eInvalidInput,
+                           "Invalid -cdr_dist range '" + s + "'. Expected format 'min:max'");
+            }
+            if (lo < 0 || hi < lo) {
+                NCBI_THROW(CInputException, eInvalidInput,
+                           "Invalid -cdr_dist bounds in '" + s + "' (require 0 <= min <= max)");
+            }
+        };
+        if (parts.size() == 1) {
+            parse_range(parts[0], min12, max12);
+            min23 = min12;
+            max23 = max12;
+        } else if (parts.size() >= 2) {
+            parse_range(parts[0], min12, max12);
+            parse_range(parts[1], min23, max23);
+        }
+    }
+    opts.SetCDRDistances(min12, max12, min23, max23);
+
+    // Parse -cdr_max_mismatches
+    vector<int> mm_vec;
+    int default_mm = 2;
+    if (args.Exist(kArgCDRMaxMismatches) && args[kArgCDRMaxMismatches]) {
+        string mm_str = NStr::TruncateSpaces(args[kArgCDRMaxMismatches].AsString());
+        vector<string> parts;
+        NStr::Split(mm_str, ",", parts);
+        for (const string& p : parts) {
+            int val = NStr::StringToInt(NStr::TruncateSpaces(p));
+            if (val < 0) {
+                NCBI_THROW(CInputException, eInvalidInput,
+                           "-cdr_max_mismatches values must be >= 0");
+            }
+            mm_vec.push_back(val);
+        }
+        if (mm_vec.size() == 1) {
+            default_mm = mm_vec[0];
+            mm_vec.push_back(default_mm);
+            mm_vec.push_back(default_mm);
+        } else if (!mm_vec.empty()) {
+            default_mm = mm_vec.back();
+        }
+    } else {
+        mm_vec = {2, 2, 2};
+    }
+    opts.SetCDRMaxMismatches(mm_vec, default_mm);
+
+    // Parse -cdr_outfmt
+    // If user explicitly passed -outfmt on CLI and did not pass -cdr_outfmt, respect -outfmt (0 = standard BLAST)
+    int cdr_outfmt = 1; // 1 = full CDR report by default
+    if (args.Exist(kArgCDROutFmt) && args[kArgCDROutFmt]) {
+        string fmt = NStr::TruncateSpaces(args[kArgCDROutFmt].AsString());
+        NStr::ToLower(fmt);
+        if (fmt == "full" || fmt == "1") {
+            cdr_outfmt = 1;
+        } else if (fmt == "tsv" || fmt == "tabular" || fmt == "2") {
+            cdr_outfmt = 2;
+        } else if (fmt == "json" || fmt == "3") {
+            cdr_outfmt = 3;
+        } else if (fmt == "compact" || fmt == "clickhouse" || fmt == "4") {
+            cdr_outfmt = 4;
+        } else if (fmt == "blast" || fmt == "0") {
+            cdr_outfmt = 0;
+        } else {
+            NCBI_THROW(CInputException, eInvalidInput,
+                       "Invalid -cdr_outfmt '" + fmt + "'. Expected 'full', 'tsv', 'json', 'compact', or 'blast'");
+        }
+    } else if (args.Exist(kArgOutputFormat) && args[kArgOutputFormat] &&
+               NStr::TruncateSpaces(args[kArgOutputFormat].AsString()) != "0") {
+        cdr_outfmt = 0;
+    }
+    opts.SetCDROutputFormat(cdr_outfmt);
+
+    // High-recall hitlist size default in CDR mode if user did not explicitly set -max_target_seqs / -num_alignments
+    if (!(args.Exist(kArgMaxTargetSequences) && args[kArgMaxTargetSequences]) &&
+        !(args.Exist(kArgNumAlignments) && args[kArgNumAlignments]) &&
+        !(args.Exist(kArgNumDescriptions) && args[kArgNumDescriptions])) {
+        opts.SetHitlistSize(cdr_outfmt == 4 ? 1000000 : 50000);
+    }
+
+    // Configure BLAST options for ultra-short CDR sensitivity while keeping core lookup table valid
+    if (m_IsProtein) {
+        if (!args.Exist(kArgWordSize) || !args[kArgWordSize]) {
+            opts.SetWordSize(2);
+        }
+        if (!args.Exist(kArgWordScoreThreshold) || !args[kArgWordScoreThreshold]) {
+            opts.SetWordThreshold(6.0);
+        }
+        opts.SetWindowSize(0);
+        opts.SetSegFiltering(false);
+        opts.SetCompositionBasedStats(eNoCompositionBasedStats);
+        if (!args.Exist(kArgEvalue) || !args[kArgEvalue]) {
+            opts.SetEvalueThreshold(100000.0);
+        }
+        opts.SetCutoffScore(1);
+    } else {
+        opts.SetLookupTableType(eNaLookupTable);
+        if (!args.Exist(kArgWordSize) || !args[kArgWordSize]) {
+            opts.SetWordSize(7);
+        }
+        opts.SetWindowSize(0);
+        opts.SetDustFiltering(false);
+        opts.SetGapExtnAlgorithm(eDynProgScoreOnly);
+        opts.SetGapTracebackAlgorithm(eDynProgTbck);
+        if (!args.Exist(kArgEvalue) || !args[kArgEvalue]) {
+            opts.SetEvalueThreshold(100000.0);
+        }
+        opts.SetCutoffScore(1);
+    }
+}
+
 END_SCOPE(blast)
 END_NCBI_SCOPE
+
