+static inline Uint4 s_ReadInt4BE(istream & is) {
+    char buf[4];
+    is.read(buf, 4);
+    return ((Uint4)(unsigned char)buf[0] << 24) |
+           ((Uint4)(unsigned char)buf[1] << 16) |
+           ((Uint4)(unsigned char)buf[2] << 8)  |
+           ((Uint4)(unsigned char)buf[3]);
+}
+
+static inline Uint8 s_ReadInt8LE(istream & is) {
+    char buf[8];
+    is.read(buf, 8);
+    Uint8 val = 0;
+    for (int i = 7; i >= 0; --i) {
+        val = (val << 8) | (unsigned char)buf[i];
+    }
+    return val;
+}
+
+bool CMakeBlastDBApp::x_AppendToDatabase(const string & dbname, const string & input_path, bool is_protein)
+{
+    // 1. Locate volume
+    string vol_name = dbname;
+    string pal_path = dbname + (is_protein ? ".pal" : ".nal");
+    if (CFile(pal_path).Exists()) {
+        ifstream pal_in(pal_path.c_str());
+        string line;
+        while (getline(pal_in, line)) {
+            NStr::TruncateSpacesInPlace(line);
+            if (NStr::StartsWith(line, "DBLIST")) {
+                vector<string> vols;
+                NStr::Split(line.substr(6), " \t", vols, NStr::fSplit_Tokenize);
+                if (!vols.empty()) {
+                    string last_vol = vols.back();
+                    if (!CDirEntry::IsAbsolutePath(last_vol)) {
+                        vol_name = CDirEntry::ConcatPath(CDirEntry(dbname).GetDir(), last_vol);
+                    } else {
+                        vol_name = last_vol;
+                    }
+                }
+            }
+        }
+    } else {
+        string pin00 = dbname + ".00" + (is_protein ? ".pin" : ".nin");
+        if (CFile(pin00).Exists()) {
+            vol_name = dbname + ".00";
+        }
+    }
+
+    string pin_path = vol_name + (is_protein ? ".pin" : ".nin");
+    if (!CFile(pin_path).Exists()) {
+        return false;
+    }
+
+    // 2. Read existing .pin
+    ifstream pin_in(pin_path.c_str(), ios::binary);
+    if (!pin_in) {
+        NCBI_THROW(CInvalidDataException, eInvalidInput, "Could not open existing index file: " + pin_path);
+    }
+
+    Uint4 ver = s_ReadInt4BE(pin_in);
+    Uint4 seqtype = s_ReadInt4BE(pin_in);
+    Uint4 vol_idx = 0;
+    if (ver == 5) {
+        vol_idx = s_ReadInt4BE(pin_in);
+    }
+    Uint4 title_len = s_ReadInt4BE(pin_in);
+    string title(title_len, '\0');
+    if (title_len > 0) {
+        pin_in.read(&title[0], title_len);
+    }
+
+    string lmdb_name;
+    if (ver == 5) {
+        Uint4 lmdb_len = s_ReadInt4BE(pin_in);
+        if (lmdb_len > 0) {
+            lmdb_name.resize(lmdb_len);
+            pin_in.read(&lmdb_name[0], lmdb_len);
+        }
+    }
+
+    Uint4 date_len = s_ReadInt4BE(pin_in);
+    string date_bytes(date_len, '\0');
+    if (date_len > 0) {
+        pin_in.read(&date_bytes[0], date_len);
+    }
+
+    Uint4 num_oids = s_ReadInt4BE(pin_in);
+    Uint8 vol_len = s_ReadInt8LE(pin_in);
+    Uint4 max_len = s_ReadInt4BE(pin_in);
+
+    vector<Uint4> hdr_offsets(num_oids + 1);
+    for (Uint4 i = 0; i <= num_oids; ++i) {
+        hdr_offsets[i] = s_ReadInt4BE(pin_in);
+    }
+    vector<Uint4> seq_offsets(num_oids + 1);
+    for (Uint4 i = 0; i <= num_oids; ++i) {
+        seq_offsets[i] = s_ReadInt4BE(pin_in);
+    }
+    pin_in.close();
+
+    // 3. Open .psq and .phr in append mode
+    string psq_path = vol_name + (is_protein ? ".psq" : ".nsq");
+    string phr_path = vol_name + (is_protein ? ".phr" : ".nhr");
+
+    fstream psq_out(psq_path.c_str(), ios::in | ios::out | ios::binary | ios::ate);
+    if (!psq_out) {
+        NCBI_THROW(CInvalidDataException, eInvalidInput, "Could not open sequence file for append: " + psq_path);
+    }
+    fstream phr_out(phr_path.c_str(), ios::in | ios::out | ios::binary | ios::ate);
+    if (!phr_out) {
+        NCBI_THROW(CInvalidDataException, eInvalidInput, "Could not open header file for append: " + phr_path);
+    }
+
+    Uint4 cur_psq_pos = (Uint4)psq_out.tellp();
+    Uint4 cur_phr_pos = (Uint4)phr_out.tellp();
+    if (cur_psq_pos != seq_offsets.back() || cur_phr_pos != hdr_offsets.back()) {
+        NCBI_THROW(CInvalidDataException, eInvalidInput, "Offset mismatch in existing DB files");
+    }
+
+    // 4. Open and read FASTA input
+    vector<CTempString> input_filenames;
+    SeqDB_SplitQuoted(input_path, input_filenames);
+
+    Uint4 added_count = 0;
+    Uint8 added_letters = 0;
+
+    for (size_t f_idx = 0; f_idx < input_filenames.size(); ++f_idx) {
+        string fname = input_filenames[f_idx];
+        unique_ptr<CNcbiIfstream> raw_f;
+        CNcbiIstream *data_in = nullptr;
+        unique_ptr<CDecompressIStream> comp_stream;
+
+        if (fname == "-") {
+            data_in = &cin;
+        } else {
+            raw_f.reset(new CNcbiIfstream(fname.c_str(), ios::binary));
+            if (!raw_f || !raw_f->is_open()) {
+                NCBI_THROW(CInvalidDataException, eInvalidInput, "Could not open input FASTA: " + fname);
+            }
+            data_in = raw_f.get();
+            if (NStr::EndsWith(fname, ".gz", NStr::eNocase)) {
+                comp_stream.reset(new CDecompressIStream(*raw_f, CDecompressIStream::eGZipFile));
+                data_in = comp_stream.get();
+            } else if (NStr::EndsWith(fname, ".bz2", NStr::eNocase)) {
+                comp_stream.reset(new CDecompressIStream(*raw_f, CDecompressIStream::eBZip2));
+                data_in = comp_stream.get();
+            } else if (NStr::EndsWith(fname, ".zst", NStr::eNocase)) {
+                comp_stream.reset(new CDecompressIStream(*raw_f, CDecompressIStream::eZstd));
+                data_in = comp_stream.get();
+            }
+        }
+
+        string line;
+        string cur_title;
+        string cur_seq;
+
+        auto flush_seq = [&]() {
+            if (cur_seq.empty()) return;
+
+            Uint4 oid = num_oids;
+
+            // Write Defline
+            CRef<CBlast_def_line_set> bdls(new CBlast_def_line_set);
+            CRef<CBlast_def_line> defline(new CBlast_def_line);
+            CRef<CSeq_id> gnl_id(new CSeq_id);
+            gnl_id->SetGeneral().SetDb("BL_ORD_ID");
+            gnl_id->SetGeneral().SetTag().SetId((int)oid);
+            defline->SetSeqid().push_back(gnl_id);
+            defline->SetTitle(cur_title);
+            bdls->Set().push_back(defline);
+
+            CNcbiOstrstream oss;
+            oss << MSerial_AsnBinary << *bdls;
+            string bin_hdr = CNcbiOstrstreamToString(oss);
+
+            phr_out.write(bin_hdr.data(), bin_hdr.size());
+            hdr_offsets.push_back((Uint4)phr_out.tellp());
+
+            // Convert and Write Sequence
+            string stdaa_seq;
+            CSeqConvert::Convert(cur_seq, CSeqUtil::e_Ncbieaa, 0, (TSeqPos)cur_seq.size(),
+                                 stdaa_seq, CSeqUtil::e_Ncbistdaa);
+            psq_out.write(stdaa_seq.data(), stdaa_seq.size());
+            char null_byte = 0;
+            psq_out.write(&null_byte, 1);
+            seq_offsets.push_back((Uint4)psq_out.tellp());
+
+            num_oids++;
+            vol_len += cur_seq.size();
+            added_letters += cur_seq.size();
+            if ((Uint4)cur_seq.size() > max_len) {
+                max_len = (Uint4)cur_seq.size();
+            }
+            added_count++;
+
+            cur_seq.clear();
+            cur_title.clear();
+        };
+
+        while (getline(*data_in, line)) {
+            if (line.empty()) continue;
+            if (line.back() == '\r') line.pop_back();
+            if (line.empty()) continue;
+
+            if (line[0] == '>') {
+                flush_seq();
+                cur_title = line.substr(1);
+            } else {
+                for (char ch : line) {
+                    if (isalpha((unsigned char)ch) || ch == '*') {
+                        cur_seq += (char)toupper((unsigned char)ch);
+                    }
+                }
+            }
+        }
+        flush_seq();
+    }
+
+    psq_out.flush();
+    psq_out.close();
+    phr_out.flush();
+    phr_out.close();
+
+    // 5. Rewrite .pin atomically
+    string pin_tmp = vol_name + (is_protein ? ".pin.tmp" : ".nin.tmp");
+    ofstream pin_out(pin_tmp.c_str(), ios::binary);
+    if (!pin_out) {
+        NCBI_THROW(CInvalidDataException, eInvalidInput, "Could not create temporary pin file: " + pin_tmp);
+    }
+
+    s_WriteInt4(pin_out, ver);
+    s_WriteInt4(pin_out, seqtype);
+    if (ver == 5) {
+        s_WriteInt4(pin_out, vol_idx);
+    }
+    s_WriteString(pin_out, title);
+    if (ver == 5) {
+        s_WriteString(pin_out, lmdb_name);
+    }
+    s_WriteInt4(pin_out, date_len);
+    pin_out.write(date_bytes.data(), date_len);
+    s_WriteInt4(pin_out, num_oids);
+    s_WriteInt8LE(pin_out, vol_len);
+    s_WriteInt4(pin_out, max_len);
+
+    for (size_t i = 0; i < hdr_offsets.size(); ++i) {
+        s_WriteInt4(pin_out, hdr_offsets[i]);
+    }
+    for (size_t i = 0; i < seq_offsets.size(); ++i) {
+        s_WriteInt4(pin_out, seq_offsets[i]);
+    }
+    pin_out.close();
+
+    CDirEntry(pin_tmp).Rename(pin_path, CDirEntry::fRF_Overwrite);
+
+    *m_LogFile << "\nAppended " << added_count << " sequences (" << added_letters
+               << " residues) to BLAST database named " << dbname << ".\n"
+               << "Database now contains " << num_oids << " sequences ("
+               << vol_len << " total residues).\n" << endl;
+
+    return true;
+}
