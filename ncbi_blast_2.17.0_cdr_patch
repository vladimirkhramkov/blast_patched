+/// Configure logical CDR/Chain slots (0=CDR1, 1=CDR2, 2=CDR3, 3=CHAIN) and chain_type ('H','L','C')
+/// from FASTA headers (>CDR1..3/>CHAIN, >HCDR1..3/>HCHAIN, >LCDR1..3/>LCHAIN) including incomplete forms,
+/// and optionally run sublinear <db>.kmeridx + mmap .pin/.psq candidate OID pre-filtering.
+void ConfigureCDRQuerySlots(blast::CBlastOptions& opt,
+                            const blast::CBlastQueryVector& query_batch,
+                            CRef<objects::CScope> scope,
+                            const string& db_name = kEmptyStr,
+                            int num_threads = 1);
+
+/// Print dedicated Antibody/TCR CDR search report (full, tsv, json, or compact ClickHouse format)
+void PrintCDRSearchResults(CNcbiOstream& out,
+                           const blast::CSearchResultSet& results,
+                           const blast::CBlastQueryVector& query_batch,
+                           CRef<objects::CScope> scope,
+                           const blast::CBlastOptions& opt,
+                           const string& db_name = kEmptyStr);
+
 END_NCBI_SCOPE
 
 #endif /* APP__BLAST_APP_UTIL__HPP */
 
